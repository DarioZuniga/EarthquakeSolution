<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Earthquake</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <header class="border-bottom bg-white py-3">
        <div class="container">
            <span class="fw-bold text-primary">
                Earthquake · Consulta de sismos
            </span>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="container py-4 text-muted small">
        Caso práctico 1 · Programación Avanzada Web
        <br />
        Fuente de los sismos: USGS
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>